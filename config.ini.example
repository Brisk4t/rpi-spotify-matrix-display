[Matrix]
hardware_mapping = adafruit-hat-pwm
brightness = 50
contrast = 100
saturation = 100
; Neutral, Warm, Cool or Night
color_profile = Neutral
gpio_slowdown = 2

[Player]
target_fps = 60
dedicated_lyrics = false
text_scroll_speed = 15
text_scroll_delay = 4
always_fullscreen = false
fullscreen_delay = 10
shutdown_delay = 30

[Spotify]
client_id = <YOUR_CLIENT_ID_HERE>
client_secret = <YOUR_CLIENT_SECRET_HERE>
sp_dc = <YOUR SP_DC COOKIE FOR LYRICS>
lyrics = false
; builtin, or librelyrics (Python 3.10+, install with: .venv/bin/pip install -e '.[librelyrics]')
lyrics_provider = builtin
fetch_interval = 1
; idle_fetch_interval = 5
; device_whitelist = ['Marantz AVR', 'Samsung TV']

[HomeAssistant]
enabled = false
mqtt_host = homeassistant.local
mqtt_port = 1883
mqtt_username =
mqtt_password =
; discovery_prefix = homeassistant
; device_id = spotify_matrix
; device_name = Spotify Matrix

[Web]
; Settings page at http://<pi address>:8000 for changing settings and authorizing Spotify without SSH
enabled = false
port = 8000
; Optional. Anyone on your network can open the page when this is empty
password =
